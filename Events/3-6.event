BeginningScene:
Music(0x48)
SetBackground(0x38)
STAL 5
BROWNBOXTEXT ValeguardKeep [8,8]
STAL 15
Music(0x48)

CHECK_EVENTID 0x95
BEQ 1 0x0 0xC
Text(Part3Chapter6Opening0Graham)
TextCont(Part3Chapter6Opening1, 0x196)
GOTO 2
LABEL 1
Text(Part3Chapter6Opening0Raial)
TextCont(Part3Chapter6Opening1Raial, 0x197)
LABEL 2

STAL 25

Music(0x298)
Text(Part3Chapter6Opening2)
STAL 5
CAM1 [11,33]
ClearBackground

STAL 20

Music(0x4d)
Text(Part3Chapter6Opening3)


	FADI 60
	LOAD1 0x1 EnemyUnits
	LOAD1 0x1 EnemyUnits2
	ENUN
	CALL $591FD8 //prep screen
	FADU 60

	CameraCursor(Maynard)
	Text(Part3Chapter6MaynardAddress)
	STAL 5
	ENDA

