//reset prep shop
ENUF 0x7F
ENUF 0x80
ENUF 0x81
	ENUT AllUnitsMustEscapeFlag
	LOAD1 0x1 EnemyUnits
	LOAD1 0x1 NewRecruits //the test units
	LOAD1 0x1 TentUnitGaming
