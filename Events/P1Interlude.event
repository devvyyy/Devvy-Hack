BeginningScene:
	LOAD2 0x1 CutsceneUnits
    LOAD2 0x1 CutsceneUnits2
    ENUN
	CAM1 [1, 10]
    FADU 15
    STAL 10
	CamOn
	MOVE 0x8 Ulrich [3, 6]
    MOVE 0x8 Breve [2, 6]
    MOVE 0x8 Ansgar [3, 7]
    MOVE 0x8 Hildr [2, 7]
    MOVE 0x8 Affogato [1, 7] //at back?
    ENUN
	CameraCursor(Ulrich)
    Music(0x2C)
	SetBackground(0x33)
    Text(Part1Interlude1)
	FADI 60
	CLEAN
	FADU 60
	MOVE 0x10 0xF4 [4, 6]
	ENUN
	STAL 5
	CameraCursor(0xF4)
	Text(Part1Interlude2)
	MOVE 0x10 0xF4 [1, 12]
    ENUN
    DISA 0xF4
    STAL 15
	Text(Part1Interlude3)
	STAL 10
	FADI 60
	LOAD1 0x1 EnemyUnits
	//BYTE 0x40 0x0D 0xC3 Supplies1; POIN SilentGiveItem+1
	//SetUnitItemDurability(Supplies1, 0, CantoOneID) //boots
	ENUN
	GotoPrepScreen
	ENDA

EndingScene:
	MNC2 0x2
	NoFade
	ENDA

